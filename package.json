{
  "name": "sql-formatter-plus",
  "displayName": "sql-formatter-plus",
  "description": "A T-SQL and SQL Server formatter with selection support, safe identifier casing, and broad syntax coverage.",
  "version": "3.1.1",
  "publisher": "MuhammadBadar",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammadbadar1998/sql-formatter-plus-3.0.git"
  },
  "homepage": "https://github.com/muhammadbadar1998/sql-formatter-plus-3.0",
  "bugs": {
    "url": "https://github.com/muhammadbadar1998/sql-formatter-plus-3.0/issues"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "sql",
    "tsql",
    "mssql",
    "sql server",
    "formatter"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sql-formatter-plus.format_sql",
        "title": "Format SQL"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.23.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
